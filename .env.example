APIFY_API_TOKEN=your_apify_api_token
APIFY_TASK_ID=your_apify_task_id
GEMINI_API_KEY=your_gemini_api_key

# Optional -- report email delivery. If unset, the pipeline still runs and
# just skips emailing the digest. EMAIL_SENDER must be a Gmail address with
# an App Password (not your regular Gmail password) -- see README.
EMAIL_SENDER=your_gmail_address@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_RECIPIENT=shinoy1010@gmail.com
